# Скопіюй у .env.local. Справжні ключі зберігай лише там.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Альтернатива без API-ключа: AI_PROVIDER=ollama або lmstudio.
# AI_MODEL — назва вже завантаженої локальної моделі.
AI_MODEL=
# Типові адреси задаються автоматично; за потреби вкажи свою локальну.
AI_BASE_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
